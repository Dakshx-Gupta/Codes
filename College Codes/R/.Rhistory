observed = c(classroom = 18, Online = 22, Hybrid = 27, Self-Study = 33)
expected_prob = c(0.25, 0.25, 0.25, 0.25)
result = chisq.test(observed, p = expected_prob)
cat("Observed frequencies: \n")
print(observed)
