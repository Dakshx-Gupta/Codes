observed = c(Classroom = 18, Online = 22, Hybrid = 27, Self_Study = 33)
expected_prob = c(0.25, 0.25, 0.25, 0.25)
result = chisq.test(observed, p = expected_prob)
cat("Observed frequencies: \n")
print(observed)
cat("\n Expected frquencies: \n")
print(result$expected)
cat("\n Chi-Square statistic: \n")
print(result$statistic)
cat("\n Degree of freedom: \n")
print(result$parameter)
cat("\nP-value: \n")
print(result$p.value)
cat("\n standarized residuals\n")
print(result$stderr)
if(result$p.value<0.05){
cat("\nReject HO: the frequencies do not fit the equalperformance model\n")
}else{
cat("\n Do not reject the HO: insufficient evidence againts the equal
performance model\n")
